<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تسجيل دخول الإداريين</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            width: 100%;
            overflow: hidden;
        }

        body { 
            font-family: Tahoma, sans-serif; 
            display: flex; 
            flex-direction: column;
            justify-content: center; 
            align-items: center; 
            position: relative;
        }

        /* حاوية الخلفية المتحركة الأولى مع التغبيش */
        .aura-background-component {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -10;
            filter: blur(8px); /* درجة التغبيش (يمكنك تعديلها لاحقاً) */
            transform: scale(1.05); /* لتغطية الحواف أثناء التغبيش */
        }
        
        .aura-background-component [data-us-project] {
            position: absolute;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            z-index: -10;
        }

        /* طبقة عتمة خفيفة فوق الخلفية */
        .bg-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.25);
            z-index: -5;
        }

        /* المربع (صافي وبدون تغبيش) باللون المطلوب #e0ebe0 */
        .login-box { 
            background: #e0ebe0; 
            padding: 40px 40px; 
            border-radius: 20px; 
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(66, 129, 119, 0.5); 
            width: 440px; 
            text-align: center; 
            box-sizing: border-box;
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            border-top: 5px solid #428177;
        }

        /* اللوغو داخل المربع */
        .server-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 10px;
            border: none;
            box-shadow: none;
            background: transparent;
        }

        /* عنوان SYRIA ID tracker بلون #428177 */
        .main-title {
            color: #428177;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 15px;
            letter-spacing: 1.5px;
            font-family: Arial, sans-serif;
            direction: ltr;
        }

        p { 
            color: #555; 
            font-size: 13px; 
            margin-bottom: 25px; 
            font-weight: bold; 
        }

        /* زر تسجيل الدخول */
        .discord-btn { 
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%; 
            padding: 15px; 
            background: #428177; 
            color: #ffffff; 
            border: 2px solid #33665e; 
            border-radius: 10px; 
            cursor: pointer; 
            font-size: 17px; 
            font-weight: bold; 
            text-decoration: none; 
            box-sizing: border-box; 
            flex-direction: row-reverse; 
            box-shadow: 0 6px 0 #2a544d, 0 10px 20px rgba(0, 0, 0, 0.4);
            transition: all 0.1s ease; 
            margin: 10px 0;
        }
        .discord-btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #2a544d, 0 5px 10px rgba(0, 0, 0, 0.4);
        }
        .discord-btn:hover { 
            background: #376d64; 
        }
        
        .discord-icon {
            width: 26px;
            height: 26px;
            fill: #ffffff; 
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    <!-- الخلفية المتحركة الأولى المطلوبة مع التغبيش -->
    <div class="aura-background-component">
        <div data-us-project="yaha7Bz5f3cRBAa5js9K"></div>
        <script type="text/javascript">
            !function(){if(!window.UnicornStudio){window.UnicornStudio={isInitialized:!1};var i=document.createElement("script");i.src="https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v1.4.29/dist/unicornStudio.umd.js",i.onload=function(){window.UnicornStudio.isInitialized||(UnicornStudio.init(),window.UnicornStudio.isInitialized=!0)},(document.head || document.body).appendChild(i)}}();
        </script>
    </div>

    <!-- طبقة التغيم فوق الخلفية -->
    <div class="bg-overlay"></div>

    <!-- المربع (صافي وبدون تغبيش) -->
    <div class="login-box">
        <img src="/logo.png" alt="Server Logo" class="server-logo">
        <div class="main-title">SYRIA ID tracker</div>

        <p>قم بربط حساب ديسكورد الخاص بك لبدء الشفت</p>
        
        <a href="/auth/discord" class="discord-btn">
            <svg class="discord-icon" viewBox="0 0 24 24">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <span>تسجيل الدخول عبر Discord</span>
        </a>
    </div>
</body>
</html>